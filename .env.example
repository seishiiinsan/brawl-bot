# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Application ID (onglet "General Information")
DISCORD_CLIENT_ID=
# Optionnel : ID du serveur de test. Si defini, les commandes sont deployees
# instantanement sur ce serveur au lieu d'attendre ~1h en global.
DISCORD_GUILD_ID=

# Cle API Brawl Stars (https://developer.brawlstars.com)
# ATTENTION : la cle est liee a l'IP du serveur qui l'utilise.
BRAWL_API_KEY=

# Optionnel : proxy API (ex. https://bsproxy.royaleapi.dev/v1) si ton IP est dynamique
BRAWL_API_BASE=https://api.brawlstars.com/v1

# Frequence des snapshots automatiques (cron, defaut : toutes les heures)
SNAPSHOT_CRON=0 * * * *
# Duree de retention des snapshots en jours
SNAPSHOT_RETENTION_DAYS=120
