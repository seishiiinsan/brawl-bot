{
  "name": "brawl-bot",
  "version": "1.0.0",
  "description": "Bot Discord de statistiques Brawl Stars : profils detailles, graphiques, progression 24h / 7j / 30j",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
